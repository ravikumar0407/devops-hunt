    {
      "parameters": {
        "jsCode": "const item = items[0];\n\nlet scored;\ntry {\n  const rawText = item.json.content[0].text;\n  const cleaned = rawText\n    .replace(/```json/g, '')\n    .replace(/```/g, '')\n    .trim();\n  scored = JSON.parse(cleaned);\n} catch(e) {\n  scored = {\n    score: 0,\n    reason: 'Could not parse Claude response',\n    matching_skills: [],\n    skill_gaps: [],\n    tailoring_angle: 'Review manually'\n  };\n}\n\nif (scored.score === 0) return [];\n\nconst job = $('Loop Over Items').item.json;\n\nreturn [{\n  json: {\n    date: new Date().toLocaleDateString('en-GB'),\n    title: job.job_title || 'No title',\n    link: job.job_url || 'No link',\n    location: job.location || '',\n    salary: job.salary_range || '',\n    score: scored.score,\n    reason: scored.reason,\n    matching_skills: Array.isArray(scored.matching_skills)\n      ? scored.matching_skills.join(', ')\n      : scored.matching_skills || '',\n    skill_gaps: Array.isArray(scored.skill_gaps)\n      ? scored.skill_gaps.join(', ')\n      : scored.skill_gaps || '',\n    tailoring_angle: scored.tailoring_angle || ''\n  }\n}];"
      },
